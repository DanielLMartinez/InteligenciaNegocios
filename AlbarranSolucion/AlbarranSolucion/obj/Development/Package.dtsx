              description="OLE DB Source"
              name="OLE DB Source Albarran"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[cargos]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    v.venta_id,
    v.sucursal_id,
    dv.producto_id,
    v.cliente_id,
    v.fecha,
    v.vendedor_id,
    dv.cantidad,
    dv.precio_unitario,
    dv.descuento,
    p.precio * (1 - 0.2) AS CostoUnitario,  -- Ejemplo de cálculo de CostoUnitario con un margen de beneficio del 20%
    dv.precio_unitario - (p.precio * (1 - 0.2)) AS MargenBruto,
    dv.precio_unitario * 0.19 AS Impuesto  -- Ejemplo de cálculo de Impuesto con un 19% de IVA
FROM 
    ventas v
INNER JOIN 
    detalle_ventas dv ON v.venta_id = dv.venta_id
INNER JOIN 
    productos p ON dv.producto_id = p.producto_id;</property>
                <property
